# RE FIRE - Apache 用の設定
# Apache のサーバーで公開する場合だけ使われる。GitHub Pages では読まれない。
# .htaccess で使えない ServerTokens / ServerSignature や、
# 存在しないエラーページの指定は、サーバーエラーの原因になるため置かない。

<IfModule mod_headers.c>
    # コンテンツセキュリティポリシー（各 HTML の meta と同じ内容 + frame-ancestors）
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self' https://formspree.io; form-action 'self' https://formspree.io; frame-ancestors 'none'; base-uri 'self'; object-src 'none'; upgrade-insecure-requests"

    Header always set X-Frame-Options "DENY"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Cross-Origin-Opener-Policy "same-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), magnetometer=(), gyroscope=(), accelerometer=(), display-capture=()"

    # HTTPS で公開していることを確認してから有効にする
    # Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"

    # サーバーの種類を外に出さない
    Header always unset X-Powered-By
    Header unset X-Powered-By

    # CSS と JS は URL に ?v= を付けて更新するので、長くキャッシュしてよい
    <FilesMatch "\.(css|js|png|jpg|jpeg|gif|webp|svg|woff|woff2)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "public, max-age=3600, must-revalidate"
    </FilesMatch>
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/ld+json image/svg+xml
</IfModule>

# 公開する必要のないファイルとフォルダ
<FilesMatch "^\.|\.(md|log|bak|sql)$">
    Require all denied
</FilesMatch>
<IfModule mod_alias.c>
    RedirectMatch 404 /\.(git|claude)(/|$)
</IfModule>

